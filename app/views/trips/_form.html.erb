<%= form_with model: trip, class: "stack" do |f| %>
  <% if trip.errors.any? %>
    <div class="errors">
      <strong><%= pluralize(trip.errors.count, "error") %> prevented saving:</strong>
      <ul><% trip.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: "Summer in Portugal", autofocus: true %>
  </div>
  <div class="field">
    <%= f.label :destination %>
    <%= f.text_field :destination, placeholder: "Lisbon, Portugal" %>
  </div>
  <div class="field-row">
    <div class="field"><%= f.label :start_date %><%= f.date_field :start_date %></div>
    <div class="field"><%= f.label :end_date %><%= f.date_field :end_date %></div>
  </div>
  <div class="field">
    <%= f.label :notes, "Notes" %>
    <%= f.text_area :notes, rows: 12, placeholder: "Itinerary, logistics, anything worth remembering. Markdown works." %>
  </div>

  <div class="field">
    <%= f.label :travellers %>
    <%= f.text_field :travellers, placeholder: "Two adults" %>
  </div>
  <div class="field-row">
    <div class="field"><%= f.label :booked_via, "Booked via" %><%= f.text_field :booked_via, placeholder: "Airline / agent / site" %></div>
    <div class="field"><%= f.label :booking_ref, "Booking reference" %><%= f.text_field :booking_ref %></div>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn-primary" %>
    <%= link_to "Cancel", (trip.persisted? ? trip_path(trip) : root_path) %>
  </div>
<% end %>
