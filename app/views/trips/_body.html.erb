<%
  meta = [ trip.destination, trip_date_range(trip), trip.travellers ].select(&:present?)
%>
<p class="trip-meta"><%= safe_join(meta, " · ") %></p>
<% if trip.booked_via.present? || trip.booking_ref.present? %>
  <p class="trip-booking">
    <% parts = [] %>
    <% parts << tag.span(trip.booked_via, class: "trip-booked-via") if trip.booked_via.present? %>
    <% parts << tag.span("Ref: #{trip.booking_ref}", class: "trip-booking-ref") if trip.booking_ref.present? %>
    <%= safe_join(parts, " · ") %>
  </p>
<% end %>

<div class="segments">
  <%= render partial: "segments/segment", collection: trip.ordered_segments, as: :segment %>
</div>

<% emails = trip.source_emails %>
<% if emails.any? %>
  <details class="raw-emails">
    <summary>Source emails (<%= emails.size %>)</summary>
    <% emails.each do |email| %>
      <div class="raw-email-item">
        <div class="raw-email-header">
          <strong><%= email.subject %></strong> ·
          <%= email.from_address %> ·
          <%= email.received_at&.strftime("%Y-%m-%d %H:%M") %>
        </div>
        <div class="raw-email-body"><pre><%= email.body %></pre></div>
      </div>
    <% end %>
  </details>
<% end %>
