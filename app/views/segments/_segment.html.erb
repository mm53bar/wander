<% manage = local_assigns.fetch(:manage, false) %>
<div class="seg">
  <div class="seg-left"><%= date_badge(segment.local_date) %></div>
  <div class="seg-right">
    <div class="seg-header">
      <span class="seg-emoji"><%= segment.emoji %></span>
      <span class="seg-type"><%= segment.kind.to_s.tr("_", " ") %></span>
    </div>
    <div class="seg-summary"><%= segment.summary %></div>

    <%
      meta = []
      meta << tag.span(segment.starts_at_label) if segment.starts_at_label.present?
      meta << tag.span("→ #{segment.ends_at_label}") if segment.ends_at_label.present?
      meta << tag.span(segment.location) if segment.location.present?
      meta << tag.span(segment.confirmation, class: "seg-conf") if segment.confirmation.present?
    %>
    <% if meta.any? %><div class="seg-meta"><%= safe_join(meta) %></div><% end %>

    <% if segment.link_list.any? %>
      <div class="seg-links">
        <% segment.link_list.each do |link| %>
          <%= link_to link.label, link.url, target: "_blank", rel: "noopener" %>
        <% end %>
      </div>
    <% end %>

    <% if segment.notes.present? %>
      <div class="seg-notes prose"><%= markdown(segment.notes) %></div>
    <% end %>

    <% if segment.qr_code %>
      <div class="seg-qr" data-controller="scan-day collapsible" data-collapsible-open-value="false"
           data-scan-day-dates-value="<%= segment.scan_dates.to_json %>">
        <button type="button" class="seg-qr-toggle" data-action="click->collapsible#toggle">
          Scan code
          <span class="seg-qr-icons" aria-hidden="true">
            <span data-collapsible-target="collapsedIcon">▸</span>
            <span data-collapsible-target="expandedIcon" style="opacity: 0;">▾</span>
          </span>
        </button>
        <div class="seg-qr-content" data-collapsible-target="content" style="max-height: 0; opacity: 0;">
          <a href="#qr-<%= segment.id %>" title="Show full screen to scan" data-turbo="false">
            <%= image_tag segment.qr_code.data_uri, alt: "Scan code" %>
          </a>
          <a id="qr-<%= segment.id %>" class="qr-full" href="#_" title="Close" data-turbo="false">
            <%= image_tag segment.qr_code.data_uri, alt: "Scan code for #{segment.summary}" %>
            <span><%= segment.summary %> · tap to close</span>
          </a>
        </div>
      </div>
    <% end %>

    <% if manage %>
      <div class="seg-actions">
        <%= link_to "Edit", edit_segment_path(segment) %>
        <%= link_to "Move", move_segment_path(segment) %>
        <%= button_to "Delete", segment_path(segment), method: :delete,
              class: "btn-danger", form: { data: { turbo_confirm: "Delete this segment?" } } %>
      </div>
    <% end %>
  </div>
</div>
