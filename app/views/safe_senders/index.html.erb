<% content_for :title, "Settings — Safe senders" %>

<h1 class="page-title">Safe senders</h1>
<p class="subtle" style="margin-bottom:1rem;">
  Email addresses or domains of travel providers. A message is treated as a
  booking when one of these appears <strong>anywhere in it</strong> — including
  the body, since forwarded confirmations carry the real sender there. Add the
  providers you book with; booking-language detection still catches the rest for
  review.
</p>

<div class="card">
  <%= form_with model: @safe_sender, class: "field-row" do |f| %>
    <div class="field" style="flex:2;">
      <%= f.label :value, "Address or domain" %>
      <%= f.text_field :value, placeholder: "no-reply@bcferries.com  or  aircanada.ca", required: true %>
    </div>
    <div class="field" style="flex:1;">
      <%= f.label :name, "Label (optional)" %>
      <%= f.text_field :name, placeholder: "BC Ferries" %>
    </div>
    <%= f.submit "Add", class: "btn-primary" %>
  <% end %>
  <% if @safe_sender.errors.any? %>
    <p class="errors" style="margin-top:0.75rem;"><%= @safe_sender.errors.full_messages.to_sentence %></p>
  <% end %>
</div>

<div class="card">
  <p class="subtle"><%= pluralize(@safe_senders.size, "sender") %> · <%= @safe_senders.active.count %> active</p>
  <table class="settings-table">
    <% @safe_senders.each do |s| %>
      <tr>
        <td class="st-value"><%= s.value %></td>
        <td class="st-note"><%= s.name %></td>
        <td class="st-actions">
          <div class="record-actions">
            <%= button_to (s.active? ? "Disable" : "Enable"), safe_sender_path(s), method: :patch,
                  params: { safe_sender: { active: !s.active } }, class: "btn-outline" %>
            <%= button_to "Remove", safe_sender_path(s), method: :delete, class: "btn-danger",
                  form: { data: { turbo_confirm: "Remove #{s.value}?" } } %>
          </div>
        </td>
      </tr>
    <% end %>
  </table>
</div>

<h1 class="page-title" style="margin-top:2rem;">Reply-to addresses</h1>
<p class="subtle" style="margin-bottom:1rem;">
  When wander captures a booking it can't turn into a segment, it replies in that
  email's own thread to say so. It will only ever reply to an address on this
  list, matched against the message's <strong>From header only</strong> — never
  the body — so a provider address quoted inside a forwarded confirmation can't
  cause a reply to that provider.
  <% if @allowed_senders.active.none? %>
    <strong>The list is empty, so no replies are being sent.</strong>
  <% end %>
</p>

<div class="card">
  <%= form_with model: @allowed_sender, class: "field-row" do |f| %>
    <div class="field" style="flex:2;">
      <%= f.label :address, "Email address" %>
      <%= f.text_field :address, placeholder: "you@example.com", required: true %>
    </div>
    <div class="field" style="flex:1;">
      <%= f.label :note, "Note (optional)" %>
      <%= f.text_field :note, placeholder: "Household" %>
    </div>
    <%= f.submit "Add", class: "btn-primary" %>
  <% end %>
</div>

<div class="card">
  <% if @allowed_senders.none? %>
    <p class="subtle" style="margin:0;">No addresses yet.</p>
  <% else %>
    <table class="settings-table">
      <% @allowed_senders.each do |s| %>
        <tr>
          <td class="st-value"><%= s.address %></td>
          <td class="st-note"><%= s.note %></td>
          <td class="st-actions">
            <div class="record-actions">
              <%= button_to (s.active? ? "Disable" : "Enable"), allowed_sender_path(s), method: :patch,
                    params: { allowed_sender: { active: !s.active } }, class: "btn-outline" %>
              <%= button_to "Remove", allowed_sender_path(s), method: :delete, class: "btn-danger",
                    form: { data: { turbo_confirm: "Remove #{s.address}?" } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </table>
  <% end %>
</div>
